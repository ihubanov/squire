{
  "mcpServers": {
    "squire": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/squire-mcp.mjs",
        "@sniffski/squire@1.34.15"
      ],
      "env": {
        "NODE_ENV": "production",
        "APPIUM_MCP_RESPECT_USER_FOCUS": "false",
        "APPIUM_MCP_CDP_ENDPOINT": "http://localhost:9222",
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1"
      }
    }
  }
}
